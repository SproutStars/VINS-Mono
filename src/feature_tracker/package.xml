<?xml version="1.0"?>
<package format="3">
  <name>feature_tracker</name>
  <version>0.1.0</version>
  <description>VINS-Mono feature tracker node (ROS 2 Humble).</description>
  <maintainer email="qintonguav@gmail.com">VINS-Mono maintainers</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>camera_model</depend>
  <depend>ros2_compat</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
